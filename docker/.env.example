# Copy to .env (gitignored) and adjust. Every value here has a working default
# in docker-compose.yml, so .env is optional for local development.

# --- MinIO (stands in for S3) ---------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Airflow --------------------------------------------------------------
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# --- Kafka ----------------------------------------------------------------
# From the host: localhost:9092. From inside the compose network: kafka:29092.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# --- Lakehouse ------------------------------------------------------------
LAKEHOUSE_CATALOG_TYPE=hadoop
LAKEHOUSE_WAREHOUSE=s3a://lakehouse/warehouse
LAKEHOUSE_CHECKPOINT_ROOT=s3a://lakehouse/checkpoints
LAKEHOUSE_S3_ENDPOINT=http://localhost:9000

# --- GTFS feeds -----------------------------------------------------------
# Subway and commuter-rail feeds need no key. The NYC bus feeds do; leave this
# empty and the bus feeds are skipped rather than faked.
GTFS_BUS_API_KEY=
GTFS_ENABLED_FEEDS=subway,alerts
GTFS_POLL_INTERVAL_SECONDS=15

# --- Producer -------------------------------------------------------------
PRODUCER_PRODUCER_ID=local-dev-1
PRODUCER_SERIALIZATION=avro

# --- AWS (production only; leave unset locally) ---------------------------
# Resolved from the ECS task / EC2 instance role. Never static keys.
# AWS_REGION=us-east-1
