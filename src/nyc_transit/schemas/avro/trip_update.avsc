{
  "type": "record",
  "name": "TripUpdateStopPrediction",
  "namespace": "info.mta.gtfs.rt.v1",
  "doc": "One arrival/departure prediction for one stop of one trip, as published by an MTA GTFS-Realtime feed. Grain: (service_date, trip_id, stop_id, stop_sequence, feed_timestamp_ms).",
  "fields": [
    {"name": "event_id", "type": "string", "doc": "blake2b-128 over the business key; the dedup key for the Iceberg MERGE."},
    {"name": "record_type", "type": "string", "doc": "Always 'trip_update'."},
    {"name": "feed_id", "type": "string", "doc": "Source feed, e.g. nyct-ace."},
    {"name": "feed_timestamp_ms", "type": "long", "doc": "FeedHeader.timestamp in epoch ms; equals ingest_timestamp_ms when the feed omitted it."},
    {"name": "ingest_timestamp_ms", "type": "long", "doc": "Producer wall clock at poll time, epoch ms."},
    {"name": "producer_id", "type": "string", "doc": "Which producer instance emitted this record."},
    {"name": "schema_version", "type": "int", "default": 1, "doc": "Canonical record schema version; bumped on a breaking field change."},

    {"name": "entity_id", "type": ["null", "string"], "default": null, "doc": "FeedEntity.id exactly as published."},
    {"name": "is_deleted", "type": "boolean", "default": false, "doc": "FeedEntity.is_deleted; set by incremental feeds to retract an entity."},
    {"name": "service_date", "type": "string", "doc": "GTFS service date YYYY-MM-DD in America/New_York. Iceberg partition column."},

    {"name": "vehicle_id", "type": ["null", "string"], "default": null},
    {"name": "vehicle_label", "type": ["null", "string"], "default": null},
    {"name": "trip_timestamp_epoch", "type": ["null", "long"], "default": null},
    {"name": "trip_delay_seconds", "type": ["null", "int"], "default": null},

    {"name": "stop_id", "type": ["null", "string"], "default": null, "doc": "Null for a cancellation, which carries no stop_time_updates."},
    {"name": "stop_sequence", "type": ["null", "int"], "default": null},
    {"name": "stop_schedule_relationship", "type": ["null", "string"], "default": null, "doc": "SCHEDULED | SKIPPED | NO_DATA | UNSCHEDULED"},

    {"name": "arrival_time_epoch", "type": ["null", "long"], "default": null},
    {"name": "arrival_delay_seconds", "type": ["null", "int"], "default": null},
    {"name": "arrival_uncertainty_seconds", "type": ["null", "int"], "default": null},
    {"name": "departure_time_epoch", "type": ["null", "long"], "default": null},
    {"name": "departure_delay_seconds", "type": ["null", "int"], "default": null},
    {"name": "departure_uncertainty_seconds", "type": ["null", "int"], "default": null},

    {"name": "trip_id", "type": ["null", "string"], "default": null},
    {"name": "route_id", "type": ["null", "string"], "default": null},
    {"name": "direction_id", "type": ["null", "int"], "default": null},
    {"name": "start_date", "type": ["null", "string"], "default": null, "doc": "Feed-supplied trip start date, YYYY-MM-DD; null when the feed omitted it."},
    {"name": "start_time", "type": ["null", "string"], "default": null, "doc": "GTFS HH:MM:SS, may exceed 24:00:00."},
    {"name": "schedule_relationship", "type": ["null", "string"], "default": null, "doc": "Trip-level: SCHEDULED | ADDED | UNSCHEDULED | CANCELED | REPLACEMENT | DUPLICATED | DELETED"},

    {"name": "nyct_train_id", "type": ["null", "string"], "default": null, "doc": "NYCT extension; null when nyct_subway_pb2 is unavailable. See docs/limitations.md."},
    {"name": "nyct_direction", "type": ["null", "string"], "default": null},
    {"name": "nyct_is_assigned", "type": ["null", "boolean"], "default": null}
  ]
}
